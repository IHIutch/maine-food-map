# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 17.

DATABASE_URL="postgres://user:password@host:5432/database?sslmode=require"

# If DATABASE_URL uses Prisma Accelerate, provide a direct URL for Prisma 8.
# DIRECT_DATABASE_URL="postgres://user:password@host:5432/database?sslmode=require"
