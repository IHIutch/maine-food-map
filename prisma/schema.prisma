generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model categories {
  id                    Int                     @id @default(autoincrement())
  slug                  String                  @unique(map: "sqlite_autoindex_categories_1")
  display_name          String
  restaurant_count      Int?                    @default(0)
  restaurant_categories restaurant_categories[]

  @@index([slug], map: "idx_category_slug")
}

model restaurant_categories {
  restaurant_id Int
  category_id   Int
  categories    categories  @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  restaurants   restaurants @relation(fields: [restaurant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([restaurant_id, category_id])
  @@index([category_id], map: "idx_restaurant_categories_category")
  @@index([restaurant_id], map: "idx_restaurant_categories_restaurant")
}

model restaurant_external_data {
  restaurant_id   Int         @id @default(autoincrement())
  google_place_id String?
  yelp_id         String?
  google_data     String?
  yelp_data       String?
  last_updated    DateTime?
  restaurants     restaurants @relation(fields: [restaurant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model reports {
  id              Int       @id @default(autoincrement())
  kind            String // photo | place_error
  status          String    @default("open") // open | resolved | dismissed
  photo_id        Int?
  restaurant_id   Int?
  reason          String
  details         String?
  reporter_email  String?
  reporter_did    String?
  created_at      DateTime  @default(now())
  resolved_at     DateTime?
  resolution_note String?

  @@index([status, kind])
}

model contributors {
  id                  Int      @id @default(autoincrement())
  did                 String?  @unique
  email               String?  @unique
  handle              String?
  attestation_version String
  agreed_at           DateTime @default(now())
}

model photos {
  id                  Int       @id @default(autoincrement())
  restaurant_id       Int
  status              String    @default("pending") // pending | approved | rejected
  uploader_did        String?
  uploader_handle     String?
  uploader_email      String?
  r2_key              String
  content_type        String
  size_bytes          Int
  alt_text            String?
  attestation_version String
  attestation_text    String
  attested_at         DateTime
  record_uri          String? // reserved for Phase 5 atproto publishing
  record_cid          String?
  created_at          DateTime  @default(now())
  reviewed_at         DateTime?

  @@index([restaurant_id, status])
  @@index([status])
}

model restaurants {
  id                       Int                       @id @default(autoincrement())
  slug                     String                    @unique(map: "sqlite_autoindex_restaurants_1")
  public_id                String?                   @unique
  title                    String
  website                  String?
  description              String?
  rating                   Float?
  review_count             Int?
  rating_source            String?
  tags                     String?
  photos                   String?
  price_level              String?
  business_status          String?
  formatted_data_updated   DateTime?
  longitude                Float?
  phone                    String?
  opening_hours            String?
  address                  String?
  latitude                 Float?
  street_address           String?
  state                    String?
  city                     String?
  postal_code              String?
  restaurant_categories    restaurant_categories[]
  restaurant_external_data restaurant_external_data?

  @@index([slug], map: "idx_restaurant_slug")
  @@index([public_id], map: "idx_restaurant_public_id")
}
