{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "maine-food-map",
    "compatibility_date": "2025-09-24",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "main": "src/server.ts",
    "preview_urls": true,
    "observability": {
        "logs": {
            "enabled": true
        }
    },
    "assets": {
        "directory": "./dist"
    },
    "vars": {
        "PUBLIC_URL": "https://www.mainefoodmap.org"
    },
    "kv_namespaces": [
        {
            "binding": "OAUTH_SESSION",
            "id": "REPLACE_WITH_wrangler_kv_namespace_create_OAUTH_SESSION"
        },
        {
            "binding": "OAUTH_STATE",
            "id": "REPLACE_WITH_wrangler_kv_namespace_create_OAUTH_STATE"
        },
        {
            "binding": "LIKES_CACHE",
            "id": "REPLACE_WITH_wrangler_kv_namespace_create_LIKES_CACHE"
        }
    ]
}
