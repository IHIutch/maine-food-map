{
  "lexicon": 1,
  "id": "app.mainefoodmap.like",
  "defs": {
    "main": {
      "type": "record",
      "description": "A like on a restaurant listed at mainefoodmap.org. Subject uri points at the restaurant's stable canonical URL (https://www.mainefoodmap.org/r/<public_id>).",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "createdAt"],
        "properties": {
          "subject": {
            "type": "ref",
            "ref": "#subjectUrl"
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "subjectUrl": {
      "type": "object",
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "format": "uri" }
      }
    }
  }
}
